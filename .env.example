# -----------------------------------------------------------------------------
# Halaxis.dev — environment (Contraxis / Apixis-family naming)
# Copy to .env.local for development. Never commit secrets.
# All values below are placeholders. The site builds and the marketing
# waitlist ships without live credentials.
# -----------------------------------------------------------------------------

# Public site URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (do not create a project from this repo; paste keys after you provision) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (shared Apixis Dev LLC account; non-fund plans only) ---
# Leave the secret blank here. Never commit a live key.
# Checkout Session metadata is product=halaxis and tier.
# Price IDs stay blank until Developer Bot creates them in Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_HALAXIS_STOCK_CHECKER_ACTIVATION=
STRIPE_PRICE_HALAXIS_STOCK_CHECKER_MONTHLY=

# Stock-checker plan checkout (card or Ixis). Off unless the string is exactly "true".
# Does not accept investment-fund money.
HALAXIS_PLANS_CHECKOUT=false

# Investment-fund kill switch. Must stay false until counsel clears solicitation.
# This flag does not turn on stock-checker plan checkout.
ENABLE_PAYMENTS=false

# --- AI assistant (educational only; refuses personalized advice) ---
# AI_PROVIDER=anthropic | openai
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=

# --- Email (waitlist fallback when Supabase is not configured) ---
RESEND_API_KEY=
EMAIL_FROM=Halaxis <hello@halaxis.dev>
EMAIL_TO=

# ── Added 2026-09-25: keys the code reads that were not listed here ──
# Required
# Random secret; Vercel Cron sends it so only the cron can call scheduled routes.
CRON_SECRET=
# This site's Apixis Wallet key (apx_live_…). From `npm run family-keys` in ApixisWallet. Server only.
WALLET_API_KEY=
# Optional
# Wallet base URL. Default https://apixis-wallet.vercel.app
APIXIS_WALLET_API_URL=
# Optional web research for agents (tavily.com).
TAVILY_API_KEY=
# Legacy names (leave unset)
# Legacy name for WALLET_API_KEY. Leave unset.
# APIXIS_WALLET_API_KEY=

# --- Read by the code but missing above (added 2026-10-02) ---
APIXIS_CLIENT_ID=halaxis
# optional; defaults to <this site>/auth/apixis/callback
APIXIS_REDIRECT_URI=
# optional; defaults to https://apixis.dev
APIXIS_WORLD_API=
# this site's Apixis world key; its SHA-256 is listed in APIXIS_WORLD_KEYS on apixis.dev
APIXIS_WORLD_KEY=
# this site's public URL
NEXT_PUBLIC_SITE_URL=
# optional; new-style key instead of the anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# optional; new-style key instead of the service role key
SUPABASE_SECRET_KEY=
