# -----------------------------------------------------------------------------
# Halaxis.dev — environment (Contraxis / Apixis-family naming)
# Copy to .env.local for development. Never commit secrets.
# All values below are placeholders. The site builds and the marketing
# waitlist ships without live credentials.
# -----------------------------------------------------------------------------

# Public site URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (do not create a project from this repo; paste keys after you provision) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Checkout skeleton; UI stays hidden until ENABLE_PAYMENTS=true) ---
# Test-mode IDs below already exist on the Apixis.dev Stripe account (test mode).
# They are placeholders only — not live secrets. Do not enable charges.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Halaxis Investor Onboarding placeholder — $0/mo, product prod_VDKg3OJ4Mhbsjy
STRIPE_PRICE_ONBOARDING=price_1UCu18BM0XItOdByzHvFHAMk
STRIPE_PRICE_ALLOCATION=
STRIPE_PRICE_SUBSCRIPTION=

# SEC / solicitation kill-switch. Must be the string "true" to enable checkout.
# Default (unset or false): marketing + waitlist only. Do not accept funds.
ENABLE_PAYMENTS=false

# --- AI assistant (educational only; refuses personalized advice) ---
# AI_PROVIDER=anthropic | openai
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=

# --- Email (waitlist fallback when Supabase is not configured) ---
RESEND_API_KEY=
EMAIL_FROM=Halaxis <hello@halaxis.dev>
EMAIL_TO=

# ── Added 2026-09-25: keys the code reads that were not listed here ──
# Required
# Random secret; Vercel Cron sends it so only the cron can call scheduled routes.
CRON_SECRET=
# This site's Apixis Wallet key (apx_live_…). From `npm run family-keys` in ApixisWallet. Server only.
WALLET_API_KEY=
# Optional
# Wallet base URL. Default https://apixis-wallet.vercel.app
APIXIS_WALLET_API_URL=
# Optional web research for agents (tavily.com).
TAVILY_API_KEY=
# Legacy names (leave unset)
# Legacy name for WALLET_API_KEY. Leave unset.
# APIXIS_WALLET_API_KEY=
